#set the size of the canvas
size(1400, 900)

#paint the background
background(252,255,255)

#create a pink rectangle
fill(255,70, 181)
noStroke()
rect(20, 20, 150, 100)

#create a red rectangle
fill(255, 3, 7)
noStroke()
rect(20, 170, 150, 100)

#create an orange rectangle
fill(255, 129, 3)
noStroke()
rect(20, 320, 150, 100)

#create a yellow rectangle
fill(255, 230, 3)
noStroke()
rect(20, 470, 150, 100)

#create a green rectangle
fill(0, 234, 80)
noStroke()
rect(20, 620, 150, 100)

#create a blue rectangle
fill(0, 168, 255)
noStroke()
rect(20, 770, 150, 100)
